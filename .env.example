# Copy this file to .env and fill it in. .env is never committed.

# Local development database, as started by `npm run db:up`.
# Port 5433 rather than the usual 5432, so it cannot clash with another Postgres.
DATABASE_URL="postgresql://dessert:dessert@localhost:5433/dessert_shop?schema=public"

# Signs the login cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""
